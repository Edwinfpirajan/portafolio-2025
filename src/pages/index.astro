---
import "../styles/global.css";
import AppWrapper from "../components/AppWrapper.jsx";
---
---

<head>
  <meta charset="UTF-8" />
  <title>El Ferchando</title>

  <meta name="description" content="Portafolio de Edwin Piraján, desarrollador de software especializado en interfaces retro, IA y experiencias interactivas.">
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- Open Graph for link preview -->
  <meta property="og:image" content="/icons/about.png" />
  <meta property="og:image:type" content="image/png" />
  <meta property="og:image:width" content="512" />
  <meta property="og:image:height" content="512" />
  <meta property="og:title" content="El Ferchando" />
  <meta property="og:description" content="Portafolio de Edwin Piraján, desarrollador de software especializado en interfaces retro, IA y experiencias interactivas." />
  <meta property="og:url" content="https://portafolio-edwin.up.railway.app/" />

  <!-- Twitter Card for link preview -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content="/icons/about.png" />
  <meta name="twitter:title" content="El Ferchando" />
  <meta name="twitter:description" content="Portafolio de Edwin Piraján, desarrollador de software especializado en interfaces retro, IA y experiencias interactivas." />

  <!-- 👇 ocupa todo el ancho, respeta notch y desactiva zoom -->
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover"
  />
</head>

<!-- Monta React una sola vez; AppWrapper elige Desktop/Mobile en cliente -->
<AppWrapper client:only="react" />
